# App
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL="postgresql://flowpos:flowpos123@localhost:5432/flowpos?schema=public"

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://flowpos:flowpos123@localhost:5672/flowpos

# FP-008: JWT & Auth
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# FP-008: OIDC Integration (Phase 2 - TODO)
# OIDC_PROVIDER_URL=https://keycloak.example.com/realms/flowpos
# OIDC_CLIENT_ID=flowpos-client
# OIDC_CLIENT_SECRET=your-client-secret
# OIDC_REDIRECT_URI=http://localhost:3000/auth/callback

# FP-008: Token Revocation Cache (Redis)
TOKEN_REVOCATION_TTL_MS=900000

# 1C Integration
ONEC_BASE_URL=
ONEC_USERNAME=
ONEC_PASSWORD=
ONEC_INFOBASE=

# Sync settings
SYNC_INTERVAL_MS=300000
SYNC_PAGE_SIZE=200
