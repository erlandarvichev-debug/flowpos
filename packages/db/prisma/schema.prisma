  posTerminals POSTerminal[]
  documents    Document[]   @relation("DocumentStore")
  docTransfers Document[]   @relation("DocumentStoreTo")
  shiftPlans   ShiftPlan[]
  openShifts   OpenShift[]

  @@unique([tenantId, onecBase, onecGuid])
  @@unique([tenantId, msAccountId, msId])
  @@unique([tenantId, id])
  @@unique([organizationId, id])
  @@map("stores")
}

model Bin {
  id      String  @id @default(uuid())
  tenantId       String  @default(dbgenerated("NULLIF(current_setting('flowpos.tenant_id', true), '')")) @map("tenant_id")
  storeId String  @map("store_id")
  name    String
  code    String?
  row     String?
  section String?
  level   String?

  store  Store   @relation(fields: [tenantId, storeId], references: [tenantId, id])
  stocks Stock[]

  @@unique([tenantId, id])
  @@map("bins")
}

model Stock {
  id        String  @id @default(uuid())
  tenantId       String  @default(dbgenerated("NULLIF(current_setting('flowpos.tenant_id', true), '')")) @map("tenant_id")
  productId String  @map("product_id")
  storeId   String  @map("store_id")
  binId     String? @map("bin_id")
  qty       Decimal @default(0) @db.Decimal(18,3)
  reserved  Decimal @default(0) @db.Decimal(18,3)
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [tenantId, productId], references: [tenantId, id])
  store   Store   @relation(fields: [tenantId, storeId], references: [tenantId, id])
  bin     Bin?    @relation(fields: [tenantId, binId], references: [tenantId, id])

  @@unique([productId, storeId, binId])
  @@index([productId])
  @@index([storeId])
  @@map("stock")
}

model Counterparty {
  id         String          @id @default(uuid())
  type       CounterpartyType @default(CUSTOMER)
  name       String
  fullName   String?         @map("full_name")
  inn        String?
  kpp        String?
  phone      String?
  email      String?
  groupId    String?         @map("group_id")
  attributes Json?
  // sync fields — 1С
  onecGuid   String?         @map("onec_guid")
  onecBase   String          @default("default") @map("onec_base")
  onecVersion String?        @map("onec_version")
  // sync fields — МойСклад
  msId           String?  @map("ms_id")
  msAccountId    String?  @map("ms_account_id")
  msConnectionId String?  @map("ms_connection_id")
  msUpdated      DateTime? @map("ms_updated")
  syncStatus SyncStatus      @default(SYNCED) @map("sync_status")
  owner      Owner           @default(C1) @map("owner")
  deleted    Boolean         @default(false)
  organizationId String?  @map("organization_id") // null — общий справочник тенанта
  tenantId       String  @default(dbgenerated("NULLIF(current_setting('flowpos.tenant_id', true), '')")) @map("tenant_id")
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")
  updatedBy  String?         @map("updated_by")

  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  organization Organization?      @relation(fields: [tenantId, organizationId], references: [tenantId, id])
  group      CounterpartyGroup? @relation(fields: [tenantId, groupId], references: [tenantId, id])
  contracts  Contract[]
  documents  Document[]

  @@unique([tenantId, onecBase, onecGuid])
  @@unique([tenantId, msAccountId, msId])
  @@index([name])
  @@index([syncStatus])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("counterparties")
}

enum CounterpartyType {
  CUSTOMER
  SUPPLIER
  BOTH
}

model CounterpartyGroup {
  id     String @id @default(uuid())
  name   String
  parentId String? @map("parent_id")
  tenantId       String  @default(dbgenerated("NULLIF(current_setting('flowpos.tenant_id', true), '')")) @map("tenant_id")

  tenant   Tenant              @relation(fields: [tenantId], references: [id])
  parent   CounterpartyGroup?  @relation("CPTree", fields: [tenantId, parentId], references: [tenantId, id])
  children CounterpartyGroup[] @relation("CPTree")
  members  Counterparty[]

  @@unique([tenantId, id])
  @@map("counterparty_groups")
}

model Contract {
  id             String   @id @default(uuid())
  tenantId       String  @default(dbgenerated("NULLIF(current_setting('flowpos.tenant_id', true), '')")) @map("tenant_id")
  counterpartyId String   @map("counterparty_id")
  number         String
  name           String?
  type           String?
  startDate      DateTime? @map("start_date")
  endDate        DateTime? @map("end_date")
  currency       String   @default("KZT")
  isActive       Boolean  @default(true) @map("is_active")
  onecGuid       String?  @map("onec_guid")
  createdAt      DateTime @default(now()) @map("created_at")

  counterparty Counterparty @relation(fields: [tenantId, counterpartyId], references: [tenantId, id])

  @@map("contracts")
}

// ─── DOCUMENTS (unified table) ───────────────────────────────────────────────

model Document {
  id             String      @id @default(uuid())
  docType        DocType     @map("doc_type")
  number         String?
  date           DateTime
  status         DocStatus   @default(DRAFT)
  organizationId String?     @map("organization_id")
  tenantId       String  @default(dbgenerated("NULLIF(current_setting('flowpos.tenant_id', true), '')")) @map("tenant_id")
  counterpartyId String?     @map("counterparty_id")
  storeId        String?     @map("store_id")
  storeToId      String?     @map("store_to_id")
  contractId     String?     @map("contract_id")
  projectId      String?     @map("project_id")
  total          Decimal?    @db.Decimal(18,2)
  comment        String?
  attributes     Json?
  postedIn1c     Boolean     @default(false) @map("posted_in_1c")
  // sync fields
  onecGuid       String?     @map("onec_guid")
  onecBase       String      @default("default") @map("onec_base")
  onecVersion    String?     @map("onec_version")
  syncStatus     SyncStatus  @default(SYNCED) @map("sync_status")
  owner          Owner       @default(PLATFORM) @map("owner")
  deleted        Boolean     @default(false)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  updatedBy      String?     @map("updated_by")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  organization Organization? @relation(fields: [tenantId, organizationId], references: [tenantId, id])
  counterparty Counterparty? @relation(fields: [tenantId, counterpartyId], references: [tenantId, id])
  store        Store?        @relation("DocumentStore", fields: [tenantId, storeId], references: [tenantId, id])
  storeTo      Store?        @relation("DocumentStoreTo", fields: [tenantId, storeToId], references: [tenantId, id])
  lines        DocumentLine[]

  @@unique([tenantId, onecBase, onecGuid])
  @@index([docType, date])
  @@index([syncStatus])
  @@index([status])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("documents")
}

enum DocType {
  // Закупки
  PURCHASE_ORDER
  SUPPLY
  INVOICE_IN
  PURCHASE_RETURN
  // Продажи
  CUSTOMER_ORDER
  DEMAND
  INVOICE_OUT
  SALES_RETURN
  // Склад
  ENTER
  LOSS
  MOVE
  INVENTORY
  // Деньги
  PAYMENT_IN
  PAYMENT_OUT
  // Розница
  RETAIL_SHIFT
  RETAIL_DEMAND
  RETAIL_RETURN
}

enum DocStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum SyncStatus {
  SYNCED
  DIRTY
  PENDING
  ERROR
  CONFLICT
}

enum Owner {
  PLATFORM
  C1
  MANUAL
}

model DocumentLine {
  id         String   @id @default(uuid())
  tenantId       String  @default(dbgenerated("NULLIF(current_setting('flowpos.tenant_id', true), '')")) @map("tenant_id")
  documentId String   @map("document_id")
  lineNo     Int      @map("line_no")
  productId  String   @map("product_id")
  qty        Decimal  @db.Decimal(18,3)
  price      Decimal? @db.Decimal(18,2)
  discount   Decimal? @db.Decimal(5,2)
  vatRate    Decimal? @map("vat_rate") @db.Decimal(5,2)
  amount     Decimal? @db.Decimal(18,2)
  attributes Json?

  document Document @relation(fields: [tenantId, documentId], references: [tenantId, id], onDelete: Cascade)
  product  Product  @relation(fields: [tenantId, productId], references: [tenantId, id])

  @@unique([documentId, lineNo])
  @@map("document_lines")
}

