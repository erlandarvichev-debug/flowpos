// ─── ЭСФ (ИС ЭСФ КГД МФ РК, InvoiceV2, SOAP api1) ──────────────────────────

/// Настройки интеграции с ИС ЭСФ для организации.
model EsfSettings {
  organizationId      String    @id @map("organization_id")
  environment         String    @default("TEST") // TEST (test3.esf.kgd.gov.kz) | PROD (esf.gov.kz)
  signerIin           String?   @map("signer_iin")           // ИИН владельца ЭЦП, от имени которого открывается сессия
  operatorFullname    String?   @map("operator_fullname")    // ФИО оператора (поле operatorFullname)
  signatureType       String    @default("COMPANY") @map("signature_type") // COMPANY | OPERATOR
  vatRegistrationDate DateTime? @map("vat_registration_date") @db.Date // B 9 (дата постановки на учёт по НДС)
  transportTypeCode   String?   @map("transport_type_code")  // E 29 «Способ отправления» (классификатор КТС № 378, прил. 3)
  defaultGoodsOrigin  String?   @map("default_goods_origin") // G 2 для товаров без своего признака (1–5); услуги всегда «6»
  autoPrepare         Boolean   @default(true) @map("auto_prepare") // готовить ЭСФ по проведённым реализациям
  /// FP-018: правила решений по видам {APPROVE|DECLINE|CONFIRM_REVOKE|REVOKE|LINK_BASIS: {deadlineDays?, fourEyes?}}.
  /// Сроки задаёт методолог: юридические сроки в коде не зашиты; не задано — «срок не задан», без автоматики.
  decisionRules       Json?     @map("decision_rules")
  inboundLastEventAt  DateTime? @map("inbound_last_event_at")
  inboundLastId       BigInt?   @map("inbound_last_id")
  /// FP-022: состояние обмена — последняя успешная синхронизация, последняя ошибка (без секретов), сбоев подряд
  syncOkAt            DateTime? @map("sync_ok_at")
  syncErrorAt         DateTime? @map("sync_error_at")
  syncError           String?   @map("sync_error")
  syncFailures        Int       @default(0) @map("sync_failures")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@map("esf_settings")
}

/// FP-022: оповещение мониторинга по организации. Одно открытое на ключ; повторное уведомление — только при
/// росте важности или по истечении интервала подавления. Владелец и runbook — в правиле (esf-alerts.ts).
model OpsAlert {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  key            String    // ESF_UNKNOWN, ESF_SYNC_STALE, …
  /// = key, пока оповещение открыто; null после закрытия — уникальность «одно открытое на ключ» без частичного индекса
  openKey        String?   @map("open_key")
  severity       String    // WARNING | CRITICAL
  owner          String
  runbook        String
  message        String
  value          Json?
  openedAt       DateTime  @default(now()) @map("opened_at")
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at")
  notifiedAt     DateTime? @map("notified_at")
  notifyCount    Int       @default(0) @map("notify_count")
  resolvedAt     DateTime? @map("resolved_at")
  traceId        String?   @map("trace_id")

  @@unique([organizationId, openKey])
  @@index([organizationId, resolvedAt])
  @@map("ops_alerts")
}

/// FP-024: карантин входящих ЭСФ — всё, что нельзя безопасно записать в реестр. Исходное тело хранится целиком
/// (как получено), с хэшем и классифицированной причиной (esf-inbound.ts). Запись не удаляется: разбор — повторной
/// обработкой (REPLAYED) или решением человека с причиной (ACCEPTED_NEW | KEPT_EXISTING | DISMISSED).
/// Одна запись на (ЭСФ, содержимое): повтор того же получения увеличивает seenCount, а не плодит записи.
model EsfInboundQuarantine {
  id                 String    @id @default(uuid())
  organizationId     String    @map("organization_id")
  environment        String
  esfId              BigInt    @map("esf_id")
  registrationNumber String?   @map("registration_number")
  invoiceStatus      String?   @map("invoice_status")   // статус ИС ЭСФ из конверта, как пришёл
  envelope           Json?                               // остальные поля конверта invoiceInfo (без тела)
  body               String                              // тело ровно как получено
  bodyHash           String    @map("body_hash")         // sha256(utf-8)
  bodyBytes          Int       @map("body_bytes")
  /// Таксономия ESF_IN_* (esf-inbound.ts INBOUND_ERRORS)
  errorCode          String    @map("error_code")
  errorDetail        String?   @map("error_detail")      // техническая причина без секретов
  /// Для конфликтов — запись реестра, с которой конфликт, и её хэш на момент обнаружения
  existingInvoiceId  String?   @map("existing_invoice_id")
  existingHash       String?   @map("existing_hash")
  status             String    @default("OPEN")          // OPEN | RESOLVED
  resolution         String?                             // REPLAYED | ACCEPTED_NEW | KEPT_EXISTING | DISMISSED
  resolutionReason   String?   @map("resolution_reason")
  resolvedBy         String?   @map("resolved_by")
  resolvedAt         DateTime? @map("resolved_at")
  resultInvoiceId    String?   @map("result_invoice_id") // запись реестра после повторной обработки/принятия
  replacedBody       String?   @map("replaced_body")     // ACCEPTED_NEW: прежнее тело записи реестра
  replayAttempts     Int       @default(0) @map("replay_attempts")
  lastReplayAt       DateTime? @map("last_replay_at")
  firstSeenAt        DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt         DateTime  @default(now()) @map("last_seen_at")
  seenCount          Int       @default(1) @map("seen_count")
  traceId            String?   @default(dbgenerated("NULLIF(current_setting('flowpos.trace_id'::text, true), ''::text)")) @map("trace_id")

  @@unique([organizationId, environment, esfId, bodyHash])
  @@index([organizationId, status])
  @@map("esf_inbound_quarantine")
}

/// Сессия ИС ЭСФ (открыта подписанным тикетом). Секретов не содержит: только sessionId.
model EsfSession {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  environment    String
  sessionId      String    @map("session_id")
  iin            String
  tin            String
  openedBy       String?   @map("opened_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  closedAt       DateTime? @map("closed_at")

  @@index([organizationId, environment, closedAt])
  @@map("esf_sessions")
}

/// ЭСФ: исходящие (из проведённых документов бухгалтерии) и входящие (загружены из ИС ЭСФ).
model EsfInvoice {
  id                 String    @id @default(uuid())
  organizationId     String    @map("organization_id")
  environment        String    @default("TEST")
  direction          String    // OUTBOUND | INBOUND
  sourceDocId        String?   @map("source_doc_id")       // documents.id (реализация/поступление)
  invoiceType        String    @default("ORDINARY_INVOICE") @map("invoice_type") // ORDINARY_INVOICE | FIXED_INVOICE | ADDITIONAL_INVOICE
  relatedInvoiceId   String?   @map("related_invoice_id")
  num                String
  date               DateTime  @db.Date
  turnoverDate       DateTime  @map("turnover_date") @db.Date
  sellerTin          String?   @map("seller_tin")
  sellerName         String?   @map("seller_name")
  customerTin        String?   @map("customer_tin")
  customerName       String?   @map("customer_name")
  counterpartyId     String?   @map("counterparty_id")
  currency           String    @default("KZT")
  totalWithoutTax    Decimal   @default(0) @map("total_without_tax") @db.Decimal(18, 2)
  totalNds           Decimal   @default(0) @map("total_nds") @db.Decimal(18, 2)
  totalWithTax       Decimal   @default(0) @map("total_with_tax") @db.Decimal(18, 2)
  /// Локальный статус: READY (сформирован, ждёт подписи) | SENT (принят в очередь ИС ЭСФ) | REJECTED (ФЛК) | далее — статус ИС ЭСФ
  status             String    @default("READY")
  esfStatus          String?   @map("esf_status")          // статус из ИС ЭСФ (InvoiceStatus)
  esfId              BigInt?   @map("esf_id")
  registrationNumber String?   @map("registration_number")
  body               String                                  // XML ровно в том виде, в каком подписан/получен
  bodyHash           String    @map("body_hash")
  signature          String?
  certificate        String?
  errors             Json?
  cancelReason       String?   @map("cancel_reason")
  // FP-018: техническое подтверждение (мы получили документ / он доставлен) — НЕ юридическое согласие.
  deliveryConfirmedAt DateTime? @map("delivery_confirmed_at")
  // Последнее исполненное решение человека (APPROVED | DECLINED | REVOKED | REVOKE_CONFIRMED | BASIS_LINKED); null — решения нет.
  businessDecision   String?   @map("business_decision")
  // Предложение автоматики (поступление того же поставщика на ту же сумму) — основанием становится только решением.
  suggestedSourceDocId String? @map("suggested_source_doc_id")
  outdated           Boolean   @default(false)              // документ-основание изменён/отменён после формирования
  sentBy             String?   @map("sent_by")
  sentAt             DateTime? @map("sent_at")
  lastUpdateAt       DateTime? @map("last_update_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  // FP-024: номер и дата уникальны в пределах продавца — у разных поставщиков входящие «№1 от 01.10» законно совпадают.
  @@unique([organizationId, environment, direction, sellerTin, num, date])
  @@unique([organizationId, environment, direction, esfId])
  @@index([organizationId, direction, status])
  @@index([sourceDocId])
  @@map("esf_invoices")
}

/// FP-019: налоговый регистр распределения входного НДС по ЭСФ — что и в каком квартале принято к зачёту.
/// Строки неизменяемы (триггер); корректировка — строка REVERSAL со ссылкой на исходную. Автоматики нет:
/// каждая строка — явная команда с основанием, правилом и его версией.
model VatCreditAllocation {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  esfInvoiceId   String    @map("esf_invoice_id")
  kind           String    // CREDIT — к зачёту | NON_CREDITABLE — не принимается к зачёту (в расходы) | REVERSAL — сторно строки
  year           Int
  quarter        Int
  amount         Decimal   @db.Decimal(18, 2) // знак как у НДС ЭСФ; у REVERSAL — противоположный исходной
  method         String    // FULL | PROPORTIONAL | MANUAL
  shareNumerator   Decimal? @map("share_numerator") @db.Decimal(18, 2)
  shareDenominator Decimal? @map("share_denominator") @db.Decimal(18, 2)
  ruleCode       String    @map("rule_code")
  ruleVersion    String    @map("rule_version")
  basis          String
  reversedId     String?   @unique @map("reversed_id")
  expenseAccount String?   @map("expense_account")
  entryId        String?   @map("entry_id") // проводка D расход / C 1420 для NON_CREDITABLE
  esfSnapshot    String    @map("esf_snapshot")
  createdBy      String    @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([organizationId, year, quarter])
  @@index([esfInvoiceId])
  @@map("vat_credit_allocations")
}

/// FP-018: решение по ЭСФ — предложено → утверждено → исполнено (или отклонено/устарело/ошибка).
/// Утверждение привязано к snapshot_hash состояния ЭСФ: изменилось состояние — решение не исполняется.
model EsfDecision {
  id                String    @id @default(uuid())
  organizationId    String    @map("organization_id")
  kind              String    // APPROVE | DECLINE | CONFIRM_REVOKE | REVOKE | LINK_BASIS
  invoiceIds        String[]  @map("invoice_ids")
  reason            String?
  basis             String    // основание: что проверено, на каком документе/переписке
  basisDocId        String?   @map("basis_doc_id") // для LINK_BASIS — документ-основание
  status            String    @default("PROPOSED") // PROPOSED | APPROVED | REJECTED | STALE | EXECUTED | FAILED
  snapshotHash      String    @map("snapshot_hash")
  requiredPermission String   @map("required_permission")
  fourEyes          Boolean   @map("four_eyes")
  dueAt             DateTime? @map("due_at")
  dueSource         String    @map("due_source") // RULE | NOT_CONFIGURED
  proposedBy        String    @map("proposed_by")
  proposedAt        DateTime  @default(now()) @map("proposed_at")
  decidedBy         String?   @map("decided_by")
  decidedAt         DateTime? @map("decided_at")
  decisionNote      String?   @map("decision_note")
  approvalExpiresAt DateTime? @map("approval_expires_at")
  executedAt        DateTime? @map("executed_at")
  result            Json?

  @@index([organizationId, status])
  @@map("esf_decisions")
}

/// Закрытие месяца мастером: итоговые показатели на момент закрытия (для сверки воспроизводимости).
model AccPeriodClose {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  period         String    // YYYY-MM
  status         String    // CLOSED | REOPENED
  summary        Json      // ОСВ, прибыль, склад, деньги, переоценка, финрезультат, хэш закрывающих проводок
  closedBy       String?   @map("closed_by")
  closedAt       DateTime  @default(now()) @map("closed_at")
  reopenedBy     String?   @map("reopened_by")
  reopenedAt     DateTime? @map("reopened_at")
  reopenReason   String?   @map("reopen_reason")

  @@index([organizationId, period])
  @@map("acc_period_closes")
}
