// ─── Бухгалтерия, этап 2: автопилот, склад и себестоимость ─────────────────

// Складское движение, порождённое проведением (основа расчёта себестоимости FIFO/средняя)
model AccStockMove {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  entryId        String   @map("entry_id")      // запись движений документа-источника
  sourceType     String   @map("source_type")
  sourceId       String   @map("source_id")
  lineNo         Int      @map("line_no")
  date           DateTime
  isActive       Boolean  @default(true) @map("is_active")
  productId      String   @map("product_id")
  storeId        String   @map("store_id")
  account        String   // счёт запасов: 1310/1320/1330/1350
  direction      String   // IN | OUT
  kind           String   // PURCHASE | ENTER | SALES_RETURN | OPENING | MOVE_IN | SALE | LOSS | PURCHASE_RETURN | MOVE_OUT
  quantity       Decimal  @db.Decimal(18, 3)
  knownCost      Decimal? @map("known_cost") @db.Decimal(18, 2) // стоимость прихода, если известна
  costAccount    String?  @map("cost_account") // куда списывается себестоимость расхода (7010, 7170, …)
  pairKey        String?  @map("pair_key")     // связь MOVE_OUT ↔ MOVE_IN
  meta           Json?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, productId, date])
  @@index([entryId])
  @@index([organizationId, sourceType, sourceId])
  @@map("acc_stock_moves")
}

// Проблемы автопилота: документ не удалось отразить в учёте (что и почему)
model AccAutopilotIssue {
  id             String    @id @default(uuid())
  organizationId String?   @map("organization_id")
  sourceType     String    @map("source_type")
  sourceId       String    @map("source_id")
  code           String
  message        String
  fix            String?
  attempts       Int       @default(1)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  resolvedAt     DateTime? @map("resolved_at")

  @@unique([sourceType, sourceId])
  @@index([organizationId, resolvedAt])
  @@map("acc_autopilot_issues")
}

// Курсор фонового сверщика автопилота
model AccAutopilotCursor {
  id        String   @id // 'trade-documents'
  updatedAt DateTime @map("updated_at")
  lastId    String?  @map("last_id")

  @@map("acc_autopilot_cursors")
}

// Импорт банковской выписки: строки с защитой от повторной загрузки
model AccBankStatementLine {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  bankAccountId  String    @map("bank_account_id")
  batchId        String    @map("batch_id")
  hash           String    // дата+сумма+номер+контрагент+назначение
  date           DateTime  @db.Date
  direction      String    // IN | OUT
  amount         Decimal   @db.Decimal(18, 2)
  docNumber      String?   @map("doc_number")
  counterpartyName String? @map("counterparty_name")
  counterpartyBin  String? @map("counterparty_bin")
  counterpartyId String?   @map("counterparty_id")
  purpose        String?
  knp            String?
  status         String    @default("NEW") // NEW | DOCUMENT_CREATED | SKIPPED
  documentId     String?   @map("document_id")
  raw            Json?
