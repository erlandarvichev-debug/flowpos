  @@unique([organizationId, id])
  @@map("work_schedules")
}

model Employee {
  id             String         @id @default(uuid())
  userId         String?        @unique @map("user_id")
  organizationId String   @default(dbgenerated("NULLIF(current_setting('flowpos.organization_id', true), '')")) @map("organization_id")
  firstName      String         @map("first_name")
  lastName       String         @map("last_name")
  middleName     String?        @map("middle_name")
  departmentId   String?        @map("department_id")
  positionId     String?        @map("position_id")
  workScheduleId String?        @map("work_schedule_id")
  employmentType EmploymentType @default(FULL_TIME) @map("employment_type")
  hireDate       DateTime?      @map("hire_date")
  fireDate       DateTime?      @map("fire_date")
  salary         Decimal?       @db.Decimal(18,2)
  hourlyRate     Decimal?       @map("hourly_rate") @db.Decimal(18,2)
  inn            String?
  phone          String?
  email          String?
  isActive       Boolean        @default(true) @map("is_active")
  // sync fields
  onecGuid       String?        @map("onec_guid")
  onecBase       String         @default("default") @map("onec_base")
  syncStatus     SyncStatus     @default(SYNCED) @map("sync_status")
  deleted        Boolean        @default(false)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  user          User?          @relation(fields: [userId], references: [id])
  department    Department?    @relation(fields: [organizationId, departmentId], references: [organizationId, id])
  position      Position?      @relation(fields: [organizationId, positionId], references: [organizationId, id])
  workSchedule  WorkSchedule?  @relation(fields: [organizationId, workScheduleId], references: [organizationId, id])
  timeEvents    TimeEvent[]
  timeSheetRows TimeSheetRow[]
  shiftResponses ShiftResponse[]
  payrolls      Payroll[]
  hrContracts   HrContract[]

  @@unique([organizationId, onecBase, onecGuid])
  @@index([lastName, firstName])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("employees")
