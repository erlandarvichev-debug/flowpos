// 6. Табель и зарплата
model TimeSheet {
  id     String          @id @default(uuid())
  month  Int
  year   Int
  organizationId String   @default(dbgenerated("NULLIF(current_setting('flowpos.organization_id', true), '')")) @map("organization_id")
  status TimeSheetStatus @default(DRAFT)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  rows TimeSheetRow[]

  @@unique([organizationId, month, year])
  @@unique([organizationId, id])
  @@map("time_sheets")
}

enum TimeSheetStatus {
  DRAFT
  APPROVED
  SENT_TO_1C
}

model TimeSheetRow {
  id           String    @id @default(uuid())
  timeSheetId  String    @map("time_sheet_id")
  employeeId   String    @map("employee_id")
  organizationId String   @default(dbgenerated("NULLIF(current_setting('flowpos.organization_id', true), '')")) @map("organization_id")
  daysWorked   Float     @default(0) @map("days_worked")
  hoursWorked  Float     @default(0) @map("hours_worked")
  hoursNight   Float     @default(0) @map("hours_night")
  hoursHoliday Float     @default(0) @map("hours_holiday")
  absenceType  String?   @map("absence_type")

  timeSheet TimeSheet @relation(fields: [organizationId, timeSheetId], references: [organizationId, id], onDelete: Cascade)
  employee  Employee  @relation(fields: [organizationId, employeeId], references: [organizationId, id])

  @@unique([timeSheetId, employeeId])
  @@map("time_sheet_rows")
}

model Payroll {
  id           String        @id @default(uuid())
  employeeId   String        @map("employee_id")
  month        Int
  year         Int
  baseSalary   Decimal       @map("base_salary") @db.Decimal(18,2)
  bonuses      Decimal       @default(0) @db.Decimal(18,2)
  deductions   Decimal       @default(0) @db.Decimal(18,2)
  taxes        Decimal       @default(0) @db.Decimal(18,2)
  netAmount    Decimal       @map("net_amount") @db.Decimal(18,2)
  status       PayrollStatus @default(DRAFT)
  onecGuid     String?       @map("onec_guid")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, month, year])
  @@map("payrolls")
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
  SENT_TO_1C
}

// ─── ANALYTICS MARTS ─────────────────────────────────────────────────────────

model MartSalesDaily {
  id           String   @id @default(uuid())
  date         DateTime @db.Date
  storeId      String?  @map("store_id")
  productGroup String?  @map("product_group")
  qty          Decimal  @db.Decimal(18,3)
  revenue      Decimal  @db.Decimal(18,2)
  cost         Decimal? @db.Decimal(18,2)
  margin       Decimal? @db.Decimal(18,2)
  refreshedAt  DateTime @default(now()) @map("refreshed_at")

  @@unique([date, storeId, productGroup])
  @@index([date])
  @@map("mart_sales_daily")
}

model MartStockSnapshot {
  id          String   @id @default(uuid())
  date        DateTime @db.Date
  storeId     String   @map("store_id")
  productId   String   @map("product_id")
  qty         Decimal  @db.Decimal(18,3)
  value       Decimal? @db.Decimal(18,2)
  refreshedAt DateTime @default(now()) @map("refreshed_at")

  @@unique([date, storeId, productId])
  @@index([date])
  @@map("mart_stock_snapshot")
}

model MartPayroll {
  id          String   @id @default(uuid())
  period      String
  department  String?
  hours       Float
  fot         Decimal  @db.Decimal(18,2)
  refreshedAt DateTime @default(now()) @map("refreshed_at")

  @@unique([period, department])
  @@map("mart_payroll")
}

model MartShiftCoverage {
  id          String   @id @default(uuid())
  date        DateTime @db.Date
  storeId     String   @map("store_id")
  required    Int
  planned     Int
  actual      Int
  refreshedAt DateTime @default(now()) @map("refreshed_at")

  @@unique([date, storeId])
  @@index([date])
  @@map("mart_shift_coverage")
}

// ════════════════════════════════════════════════════════════════════════════
// HRMS & PAYROLL (Казахстан) — Этап 1: кадры + расчёт ЗП
// Деньги — Decimal(15,2). Все таблицы привязаны к организации (tenant).
// ════════════════════════════════════════════════════════════════════════════

// Учётная политика компании (feature flags + реквизиты для банка/проводок)
model HrPolicy {
  organizationId         String  @id @map("organization_id")
  companyName            String  @map("company_name")
  companyBin             String? @map("company_bin")
  companyIban            String? @map("company_iban")
  companyBic             String? @map("company_bic")
  companyBankName        String? @map("company_bank_name")
  chiefName              String? @map("chief_name")
  accountantName         String? @map("accountant_name")
  controlStaffingTable   Boolean @default(true) @map("control_staffing_table")
  blockOnStaffingOverrun Boolean @default(false) @map("block_on_staffing_overrun")
  useGradingSystem       Boolean @default(true) @map("use_grading_system")
  syncWithEsutdAutomated Boolean @default(false) @map("sync_with_esutd_automated")
  salaryKnp              String  @default("332") @map("salary_knp")
  // Счета плана счетов РК для сводных проводок (сверить с главбухом)
  accounts               Json?
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("tenant_hr_policies")
}

// Налоговые параметры по году (МРП, МЗП, ставки, пределы). Меняются без кода.
model HrTaxRule {
  id             String   @id @default(uuid())
  organizationId String?  @map("organization_id") // null = общий для всех
  year           Int
  params         Json     // см. apps/api/src/modules/hrms/tax/kz-tax.rules.ts
  note           String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, year])
  @@map("hr_tax_rules")
}

// Производственный календарь: праздники и переносы
model HrCalendarDay {
  id             String   @id @default(uuid())
  organizationId String?  @map("organization_id")
  date           DateTime @db.Date
  kind           String   // HOLIDAY (выходной) | WORKDAY (рабочий перенос)
  name           String?

  @@unique([organizationId, date])
  @@map("hr_calendar_days")
}

// Физические лица
model Individual {
  id                     String    @id @default(uuid())
  organizationId         String    @map("organization_id")
  iin                    String    @db.VarChar(12)
  lastName               String    @map("last_name")
  firstName              String    @map("first_name")
  middleName             String?   @map("middle_name")
  birthDate              DateTime  @map("birth_date") @db.Date
  gender                 String    // MALE | FEMALE
  isResident             Boolean   @default(true) @map("is_resident")
  citizenshipCountryCode String    @default("KAZ") @map("citizenship_country_code") @db.VarChar(3)
  phone                  String?
  // Льготы/исключения по налогам
  isPensioner            Boolean   @default(false) @map("is_pensioner")
  disabilityGroup        Int?      @map("disability_group")
  disabilityIndefinite   Boolean   @default(false) @map("disability_indefinite") // инвалидность установлена бессрочно (СК ст. 248)
  opvByApplication       Boolean   @default(false) @map("opv_by_application")   // инвалид I–II бессрочно, ОПВ по заявлению
  fullTimeStudent        Boolean   @default(false) @map("full_time_student")    // очное обучение: ВОСМС/ООСМС не платятся (закон об ОСМС ст. 26)
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  contracts HrContract[]

  @@unique([organizationId, iin])
  @@unique([organizationId, id])
  @@map("individuals")
}

// Справочник грейдов
model SalaryGrade {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  gradeLevel     String   @map("grade_level")
  minSalary      Decimal  @map("min_salary") @db.Decimal(15, 2)
  maxSalary      Decimal  @map("max_salary") @db.Decimal(15, 2)
  validFrom      DateTime @map("valid_from") @db.Date
  validTo        DateTime @default(dbgenerated("'9999-12-31'::date")) @map("valid_to") @db.Date

  rateValues GradeRateValue[]
  slots      StaffingSlot[]

  @@index([organizationId, gradeLevel])
  @@unique([organizationId, id])
  @@map("salary_grades")
}

// Типы ставок (модификатор оклада под ритейл)
model RateType {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  code           String
  name           String
  rateUnit       String @default("MONTHLY") @map("rate_unit") // MONTHLY | HOURLY

  rateValues GradeRateValue[]
  history    EmploymentHistory[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@map("rate_types")
}

// Матрица Грейд × Тип ставки → оклад
model GradeRateValue {
  id         String   @id @default(uuid())
  organizationId String   @default(dbgenerated("NULLIF(current_setting('flowpos.organization_id', true), '')")) @map("organization_id")
  gradeId    String   @map("grade_id")
  rateTypeId String   @map("rate_type_id")
  value      Decimal  @db.Decimal(15, 2)
  validFrom  DateTime @map("valid_from") @db.Date
  validTo    DateTime @default(dbgenerated("'9999-12-31'::date")) @map("valid_to") @db.Date

  grade    SalaryGrade @relation(fields: [organizationId, gradeId], references: [organizationId, id], onDelete: Restrict)
  rateType RateType    @relation(fields: [organizationId, rateTypeId], references: [organizationId, id], onDelete: Restrict)

  @@index([gradeId, rateTypeId])
  @@map("grade_rate_values")
}

// Штатное расписание (слоты)
model StaffingSlot {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  departmentId   String   @map("department_id")
  positionId     String   @map("position_id")
  nkzCode        String   @map("nkz_code") @db.VarChar(6)
  gradeId        String?  @map("grade_id")
  quantity       Decimal  @default(1) @db.Decimal(5, 2)
  validFrom      DateTime @map("valid_from") @db.Date
  validTo        DateTime @default(dbgenerated("'9999-12-31'::date")) @map("valid_to") @db.Date

  grade SalaryGrade? @relation(fields: [organizationId, gradeId], references: [organizationId, id])

  @@index([organizationId, departmentId, positionId])
  @@map("staffing_table")
}

// Трудовые договоры
model HrContract {
  id                    String    @id @default(uuid())
  organizationId        String    @map("organization_id")
  individualId          String    @map("individual_id")
  employeeId            String?   @map("employee_id") // связь с существующим Employee (табель, отметки)
  contractNumber        String    @map("contract_number")
  contractDate          DateTime  @map("contract_date") @db.Date
  hireDate              DateTime  @map("hire_date") @db.Date
  fireDate              DateTime? @map("fire_date") @db.Date
  esutdId               String?   @map("esutd_id")
  status                String    @default("ACTIVE") // ACTIVE | SUSPENDED | TERMINATED
  isMainJob             Boolean   @default(true) @map("is_main_job")
  applyStandardDeduction Boolean  @default(true) @map("apply_standard_deduction") // заявление на вычет 30 МРП
  vacationDaysPerYear   Int       @default(24) @map("vacation_days_per_year")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  individual   Individual          @relation(fields: [organizationId, individualId], references: [organizationId, id], onDelete: Restrict)
  employee     Employee?           @relation(fields: [organizationId, employeeId], references: [organizationId, id])
  history      EmploymentHistory[]
  bankDetails  EmployeeBankDetail[]
  accruals     OneTimeAccrual[]
  results      PayrollResult[]
  terminations EmployeeTermination[]

  @@unique([organizationId, contractNumber])
  @@unique([organizationId, id])
  @@map("employment_contracts")
}

// Главный темпоральный (bitemporal) регистр кадровой истории
model EmploymentHistory {
  id                  String    @id @default(uuid())
  organizationId String   @default(dbgenerated("NULLIF(current_setting('flowpos.organization_id', true), '')")) @map("organization_id")
  contractId          String    @map("contract_id")
  validFrom           DateTime  @map("valid_from")
  validTo             DateTime  @default(dbgenerated("'9999-12-31 23:59:59'::timestamp")) @map("valid_to")
  systemCreatedAt     DateTime  @default(now()) @map("system_created_at")
  systemInvalidatedAt DateTime? @map("system_invalidated_at")
  departmentId        String    @map("department_id")
  positionId          String    @map("position_id")
  nkzCode             String?   @map("nkz_code") @db.VarChar(6)
  gradeId             String?   @map("grade_id")
  rateTypeId          String?   @map("rate_type_id")
  scheduleId          String?   @map("schedule_id")
  rateUnit            String    @default("MONTHLY") @map("rate_unit") // MONTHLY | HOURLY
  employmentRate      Decimal   @default(1) @map("employment_rate") @db.Decimal(4, 2) // доля ставки
  calculatedSalary    Decimal   @map("calculated_salary") @db.Decimal(15, 2)
  eventType           String    @map("event_type") // HIRE | TRANSFER | SALARY_CHANGE | TERMINATION
  createdBy           String?   @map("created_by")
  comment             String?

  contract HrContract @relation(fields: [organizationId, contractId], references: [organizationId, id], onDelete: Cascade)
  rateType RateType?  @relation(fields: [organizationId, rateTypeId], references: [organizationId, id])

  @@index([contractId, validFrom])
  @@index([contractId, systemInvalidatedAt])
  @@map("employment_history")
}

// Банковские реквизиты сотрудников
model EmployeeBankDetail {
  id         String   @id @default(uuid())
  contractId String   @map("contract_id")
  iban       String   @db.VarChar(20)
  bic        String   @db.VarChar(11)
  bankName   String   @map("bank_name")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  contract HrContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  // IBAN был уникален на всю базу: один счёт нельзя было указать в договорах двух организаций,
  // а совпадение у другого клиента выдавало, что такой счёт в базе есть (FP-008).
  @@unique([contractId, iban])
  @@map("employee_bank_details")
}

// Разовые начисления/удержания
model OneTimeAccrual {
  id          String   @id @default(uuid())
  contractId  String   @map("contract_id")
  period      DateTime @db.Date // YYYY-MM-01
  accrualType String   @map("accrual_type") // KPI_BONUS | COMPENSATION | INVENTORY_PENALTY
  amount      Decimal  @db.Decimal(15, 2)
  description String?
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  contract HrContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId, period])
  @@map("one_time_accruals")
}

// Период расчёта ЗП (закрытие месяца)
model PayrollPeriod {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  period         DateTime  @db.Date // YYYY-MM-01
  status         String    @default("OPEN") // OPEN | CALCULATED | CLOSED
  calculatedAt   DateTime? @map("calculated_at")
  closedAt       DateTime? @map("closed_at")
  closedBy       String?   @map("closed_by")
  totals         Json?

  results PayrollResult[]
  journal JournalEntry[]

  @@unique([organizationId, period])
  @@unique([organizationId, id])
  @@map("payroll_periods")
}

// Результат расчёта ЗП по договору за месяц
model PayrollResult {
  id               String   @id @default(uuid())
  organizationId String   @default(dbgenerated("NULLIF(current_setting('flowpos.organization_id', true), '')")) @map("organization_id")
  payrollPeriodId  String   @map("payroll_period_id")
  contractId       String   @map("contract_id")
  period           DateTime @db.Date
  departmentId     String?  @map("department_id")
  normDays         Int      @default(0) @map("norm_days")
  workedDays       Decimal  @default(0) @map("worked_days") @db.Decimal(6, 2)
  workedHours      Decimal  @default(0) @map("worked_hours") @db.Decimal(8, 2)
  baseAccrued      Decimal  @map("base_accrued") @db.Decimal(15, 2)
  bonusAccrued     Decimal  @default(0) @map("bonus_accrued") @db.Decimal(15, 2)
  totalGrossSalary Decimal  @map("total_gross_salary") @db.Decimal(15, 2)
  opvAmount        Decimal  @map("opv_amount") @db.Decimal(15, 2)
  vosmsAmount      Decimal  @map("vosms_amount") @db.Decimal(15, 2)
  standardDeduction Decimal @default(0) @map("standard_deduction") @db.Decimal(15, 2)
  ipnBase          Decimal  @default(0) @map("ipn_base") @db.Decimal(15, 2)
  ipnAmount        Decimal  @map("ipn_amount") @db.Decimal(15, 2)
  soAmount         Decimal  @map("so_amount") @db.Decimal(15, 2)
  snAmount         Decimal  @map("sn_amount") @db.Decimal(15, 2)
  oosmsAmount      Decimal  @map("oosms_amount") @db.Decimal(15, 2)
  opvrAmount       Decimal  @map("opvr_amount") @db.Decimal(15, 2)
  otherDeductions  Decimal  @default(0) @map("other_deductions") @db.Decimal(15, 2)
  netSalaryToPay   Decimal  @map("net_salary_to_pay") @db.Decimal(15, 2)
  details          Json?    // расшифровка: сегменты истории, ставки, пределы
  isClosed         Boolean  @default(false) @map("is_closed")
  createdAt        DateTime @default(now()) @map("created_at")

  payrollPeriod PayrollPeriod @relation(fields: [organizationId, payrollPeriodId], references: [organizationId, id], onDelete: Cascade)
  contract      HrContract    @relation(fields: [organizationId, contractId], references: [organizationId, id])

  @@unique([payrollPeriodId, contractId])
  @@index([contractId, period])
  @@map("payroll_results")
}

// Расчёт при увольнении (день в день + компенсация отпуска)
model EmployeeTermination {
  id                         String   @id @default(uuid())
  contractId                 String   @map("contract_id")
  terminationDate            DateTime @map("termination_date") @db.Date
  reasonCode                 String   @map("reason_code")
  unusedVacationDays         Decimal  @map("unused_vacation_days") @db.Decimal(6, 2)
  calculatedAvgDailyWage     Decimal  @map("calculated_avg_daily_wage") @db.Decimal(15, 2)
  vacationCompensationAmount Decimal  @map("vacation_compensation_amount") @db.Decimal(15, 2)
  earnedSalaryAmount         Decimal  @map("earned_salary_amount") @db.Decimal(15, 2)
  details                    Json?
  status                     String   @default("CALCULATED")
  createdAt                  DateTime @default(now()) @map("created_at")

  contract HrContract @relation(fields: [contractId], references: [id])

  @@map("employee_terminations")
}

// Сводные бухгалтерские проводки (агрегация до подразделения)
model JournalEntry {
  id              String   @id @default(uuid())
  payrollPeriodId String   @map("payroll_period_id")
  period          DateTime @db.Date
  departmentId    String?  @map("department_id")
  description     String
  isSynced        Boolean  @default(false) @map("is_synced")
  createdAt       DateTime @default(now()) @map("created_at")

  payrollPeriod PayrollPeriod      @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  lines         JournalEntryLine[]

  @@map("journal_entries")
}

model JournalEntryLine {
  id            String  @id @default(uuid())
  entryId       String  @map("entry_id")
  debitAccount  String  @map("debit_account")
  creditAccount String  @map("credit_account")
  amount        Decimal @db.Decimal(15, 2)
  description   String?

  entry JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@map("journal_entry_lines")
}

// ════════════════════════════════════════════════════════════════════════════
// БУХГАЛТЕРИЯ (VPNet Accounting внутри FlowPOS) — Этап 1: ядро
// Инварианты: docs/accounting/INVARIANTS.md. Деньги — Decimal(18,2), без float.
// ════════════════════════════════════════════════════════════════════════════

// Доступ пользователя к организации (несколько организаций, бухгалтерская фирма)
model OrgMembership {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  organizationId String   @map("organization_id")
  tenantId       String  @default(dbgenerated("NULLIF(current_setting('flowpos.tenant_id', true), '')")) @map("tenant_id")
  role           String   // owner|admin|chief_accountant|accountant|hr|cashier|storekeeper|manager|auditor
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [tenantId, organizationId], references: [tenantId, id])
  user         User         @relation(fields: [tenantId, userId], references: [tenantId, id])

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("org_memberships")
}

// Учётная политика с датой начала действия
model AccPolicy {
  id                 String   @id @default(uuid())
  organizationId     String   @map("organization_id")
  validFrom          DateTime @map("valid_from") @db.Date
  vatPayer           Boolean  @default(false) @map("vat_payer")
  taxRegime          String   @default("GENERAL") @map("tax_regime") // GENERAL | SIMPLIFIED | RETAIL_TAX | OTHER
  inventoryMethod    String   @default("FIFO") @map("inventory_method") // FIFO | AVERAGE
  allowNegativeStock Boolean  @default(false) @map("allow_negative_stock")
  baseCurrency       String   @default("KZT") @map("base_currency")
  chartId            String?  @map("chart_id")
  params             Json?
  createdBy          String?  @map("created_by")
  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([organizationId, validFrom])
  @@map("acc_policies")
}

// Версия плана счетов
model AccChart {
  id        String    @id @default(uuid())
  code      String    // KZ-TYPICAL
  version   Int
  name      String
  validFrom DateTime  @map("valid_from") @db.Date
  validTo   DateTime? @map("valid_to") @db.Date
  source    String?
  createdAt DateTime  @default(now()) @map("created_at")

  accounts AccAccount[]

  @@unique([code, version])
  @@map("acc_charts")
}

// Счёт / субсчёт. organizationId = null — типовой счёт плана, иначе субсчёт организации
model AccAccount {
  id             String   @id @default(uuid())
  chartId        String   @map("chart_id")
  organizationId String?  @map("organization_id")
  code           String
  name           String
  nameKk         String?  @map("name_kk")
  parentId       String?  @map("parent_id")
  kind           String   @default("AP") // A (активный) | P (пассивный) | AP (активно-пассивный)
  isGroup        Boolean  @default(false) @map("is_group") // по группе проводки запрещены
  isOffBalance   Boolean  @default(false) @map("is_off_balance")
  isQuantitative Boolean  @default(false) @map("is_quantitative")
  isCurrency     Boolean  @default(false) @map("is_currency")
  dims           String[] @default([]) // аналитики по порядку: COUNTERPARTY, CONTRACT, PRODUCT, STORE, ...
  requiredDims   String[] @default([]) @map("required_dims")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  chart    AccChart     @relation(fields: [chartId], references: [id])
  parent   AccAccount?  @relation("AccTree", fields: [parentId], references: [id])
  children AccAccount[] @relation("AccTree")
  postings AccPosting[]

  @@unique([chartId, organizationId, code])
  @@index([chartId, code])
  @@map("acc_accounts")
}

// Бухгалтерский документ (ручная операция и будущие документы учёта)
model AccDocument {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  docType        String    @map("doc_type") // MANUAL_OPERATION | OPENING_BALANCE | STORNO | ...
  number         String
  date           DateTime  // дата операции
  status         String    @default("DRAFT") // DRAFT | POSTED | CANCELLED
  version        Int       @default(1)
  currency       String    @default("KZT")
  amount         Decimal   @default(0) @db.Decimal(18, 2)
  comment        String?
  body           Json      // содержимое документа (строки и реквизиты по типу)
  baseDocumentId String?   @map("base_document_id") // создан на основании
  reversalOfId   String?   @map("reversal_of_id")   // сторно документа
  authorId       String?   @map("author_id")
  updatedById    String?   @map("updated_by_id")
  postedAt       DateTime? @map("posted_at")
  externalSource String?   @map("external_source") // FLOWPOS | 1C | MOYSKLAD | IMPORT
  externalId     String?   @map("external_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  versions AccDocumentVersion[]

  @@unique([organizationId, docType, number])
  @@unique([organizationId, externalSource, externalId])
  @@index([organizationId, date])
  @@index([organizationId, status])
  @@map("acc_documents")
}

// История версий документа (неизменяемая)
model AccDocumentVersion {
  id          String   @id @default(uuid())
  documentId  String   @map("document_id")
  version     Int
  action      String   // CREATE | UPDATE | POST | UNPOST | CANCEL | RESTORE
  snapshot    Json
  changedById String?  @map("changed_by_id")
  reason      String?
  createdAt   DateTime @default(now()) @map("created_at")

  document AccDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, version])
  @@map("acc_document_versions")
}

// Регистратор движений: одна активная запись на источник (частичный уникальный индекс в SQL)
model AccEntry {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  sourceType     String    @map("source_type") // ACC_DOCUMENT | TRADE_DOCUMENT | POS_SHIFT | PAYROLL ...
  sourceId       String    @map("source_id")
  sourceVersion  Int       @map("source_version")
  ruleCode       String    @map("rule_code")
  ruleVersion    String    @map("rule_version")
  date           DateTime
  status         String    @default("ACTIVE") // ACTIVE | SUPERSEDED | CANCELLED
  createdById    String?   @map("created_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  closedAt       DateTime? @map("closed_at")

  postings AccPosting[]

  @@index([organizationId, sourceType, sourceId])
  @@index([organizationId, date])
  @@unique([organizationId, id])
  @@map("acc_entries")
}

// Проводка: строка двойной записи по стороне (D/C) в разрезе учёта (BU — бух, NU — налоговый)
model AccPosting {
  id             String   @id @default(uuid())
  entryId        String   @map("entry_id")
  organizationId String   @map("organization_id")
  date           DateTime
  isActive       Boolean  @default(true) @map("is_active")
  ledger         String   @default("BU") // BU | NU
  lineNo         Int      @map("line_no")
  side           String   // D | C
  accountId      String   @map("account_id")
  amount         Decimal  @db.Decimal(18, 2) // в тенге
  currency       String?
  currencyAmount Decimal? @map("currency_amount") @db.Decimal(18, 2)
  quantity       Decimal? @db.Decimal(18, 3)
  counterpartyId String?  @map("counterparty_id")
  contractId     String?  @map("contract_id")
  productId      String?  @map("product_id")
  storeId        String?  @map("store_id")
  employeeId     String?  @map("employee_id")
  departmentId   String?  @map("department_id")
  bankAccountId  String?  @map("bank_account_id")
  cashboxId      String?  @map("cashbox_id")
  projectId      String?  @map("project_id")
  itemId         String?  @map("item_id") // статья доходов/расходов/ДДС
  settlementDocId String? @map("settlement_doc_id")
  memo           String?

  entry   AccEntry   @relation(fields: [organizationId, entryId], references: [organizationId, id], onDelete: Restrict)
  account AccAccount @relation(fields: [accountId], references: [id])

  @@index([organizationId, accountId, date])
  @@index([organizationId, date])
  @@index([entryId])
  @@map("acc_postings")
}

// Блокировка периода: всё до lockedUntil включительно закрыто
model AccPeriodLock {
  organizationId String   @id @map("organization_id")
  lockedUntil    DateTime @map("locked_until") @db.Date
  updatedById    String?  @map("updated_by_id")
  updatedAt      DateTime @updatedAt @map("updated_at")

