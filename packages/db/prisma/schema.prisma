generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── CORE: Auth & RBAC ───────────────────────────────────────────────────────

model Tenant {
  id        String   @id @default(uuid())
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  organizations      Organization[]
  products           Product[]
  productGroups      ProductGroup[]
  uoms               Uom[]
  priceTypes         PriceType[]
  counterparties     Counterparty[]
  counterpartyGroups CounterpartyGroup[]
  documents          Document[]

  @@map("tenants")
}

model Organization {
  id        String   @id @default(uuid())
  tenantId       String  @default(dbgenerated("NULLIF(current_setting('flowpos.tenant_id', true), '')")) @map("tenant_id")
  name      String
  inn       String?  // БИН/ИИН
  kpp       String?
  address   String?
  phone     String?
  email     String?
  legalForm String   @default("TOO") @map("legal_form") // TOO | IP | AO | OTHER
  nameKk    String?  @map("name_kk")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant              Tenant             @relation(fields: [tenantId], references: [id])
  users               User[]
  documents           Document[]
  posTerminals        POSTerminal[]
  onecConnections     OnecConnection[]
  moyskladConnections MoyskladConnection[]
  memberships         OrgMembership[]
  products            Product[]
  counterparties      Counterparty[]
  stores              Store[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("organizations")
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String    @map("password_hash")
  firstName      String    @map("first_name")
  lastName       String    @map("last_name")
  middleName     String?   @map("middle_name")
  phone          String?
  isActive       Boolean   @default(true) @map("is_active")
  lastLoginAt    DateTime? @map("last_login_at")
  // FP-008: TOTP. Секрет — только зашифрованным (AES-256-GCM, ключ MFA_SECRET_KEY); коды восстановления — хэши.
  mfaSecretEnc     String?   @map("mfa_secret_enc")
  mfaEnabledAt     DateTime? @map("mfa_enabled_at")
  mfaLastStep      Int?      @map("mfa_last_step") // последний принятый шаг TOTP: код не принимается повторно
  mfaRecoveryCodes String[]  @default([]) @map("mfa_recovery_codes")
  mfaFailedCount   Int       @default(0) @map("mfa_failed_count") // подряд неверных кодов
  mfaLockedUntil   DateTime? @map("mfa_locked_until") // перебор кода: блокировка второго фактора
  organizationId String    @map("organization_id")
  tenantId       String  @default(dbgenerated("NULLIF(current_setting('flowpos.tenant_id', true), '')")) @map("tenant_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization  Organization       @relation(fields: [tenantId, organizationId], references: [tenantId, id])
  memberships   OrgMembership[]
  refreshTokens RefreshToken[]
  sessions      AuthSession[]
  identities    UserIdentity[]
  userRoles     UserRole[]
  auditLogs     AuditLog[]
  employee      Employee?

  @@unique([tenantId, id])
  @@map("users")
}

/// FP-008: серверная сессия входа. Access-токен несёт sid и действует, только пока сессия не отозвана и не истекла.
model AuthSession {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  userId        String    @map("user_id")
  authMethod    String    @default("password") @map("auth_method") // password | oidc
  createdAt     DateTime  @default(now()) @map("created_at")
  lastUsedAt    DateTime  @default(now()) @map("last_used_at")
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  revokedReason String?   @map("revoked_reason")
  mfaAt         DateTime? @map("mfa_at") // сессия открыта со вторым фактором
  ip            String?
  userAgent     String?   @map("user_agent")

  user          User           @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@map("auth_sessions")
}

/// FP-008: внешняя учётная запись (OIDC), привязанная к пользователю. Связь — только по (issuer, subject):
/// email у провайдера не доказывает владение учётной записью FlowPOS.
model UserIdentity {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  userId      String    @map("user_id")
  issuer      String
  subject     String
  email       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  lastLoginAt DateTime? @map("last_login_at")

  user User @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@unique([issuer, subject])
  @@index([userId])
  @@map("user_identities")
}

/// FP-008: одноразовое состояние входа через OIDC (state, nonce, PKCE verifier) — на сервере, живёт 10 минут.
model OidcState {
  state        String    @id
  nonce        String
  codeVerifier String    @map("code_verifier")
  purpose      String // login | link
  userId       String?   @map("user_id") // для привязки — кто привязывает
  createdAt    DateTime  @default(now()) @map("created_at")
  expiresAt    DateTime  @map("expires_at")
  usedAt       DateTime? @map("used_at")

  @@index([expiresAt])
  @@map("oidc_states")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique // sha256 токена (FP-008); сам токен — только у клиента в httpOnly cookie
  sessionId String?  @map("session_id")
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  session AuthSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@map("refresh_tokens")
}

model Role {
  id          String @id @default(uuid())
  name        String @unique
  displayName String @map("display_name")
  description String?
  isSystem    Boolean @default(false) @map("is_system")

  userRoles   UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id       String @id @default(uuid())
  module   String
  action   String
  resource String

  rolePermissions RolePermission[]

  @@unique([module, action, resource])
  @@map("permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  before    Json?
  after     Json?
  ipAddress String?  @map("ip_address")
  organizationId String? @map("organization_id")
  reason    String?
  ts        DateTime @default(now())
  /// FP-022: код трассировки запроса/фоновой задачи (заполняет БД из set_config контекста запроса)
  traceId   String?  @default(dbgenerated("NULLIF(current_setting('flowpos.trace_id'::text, true), ''::text)")) @map("trace_id")

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([ts])
  @@index([traceId])
  @@map("audit_log")
}

// ─── 1С CONNECTIONS ──────────────────────────────────────────────────────────

model OnecConnection {
  id             String     @id @default(uuid())
  organizationId String     @map("organization_id")
  name           String
  baseCode       String     @map("base_code")
  baseUrl        String     @map("base_url")
  instanceType   OnecType   @default(ONPREM) @map("instance_type")
  username       String
  passwordEnc    String     @map("password_enc")
  isActive       Boolean    @default(true) @map("is_active")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  syncCursors  SyncCursor[]
  syncLogs     SyncLog[]
  idMaps       IdMap[]
  outboxEntries Outbox[]

  @@unique([organizationId, baseCode])
  @@map("onec_connections")
}

enum OnecType {
  ONPREM
  FRESH
}

// ─── MOYSKLAD CONNECTIONS ─────────────────────────────────────────────────────

model MoyskladConnection {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  accountId      String   @map("account_id")
  tokenEnc       String   @map("token_enc")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization         @relation(fields: [organizationId], references: [id])
  syncCursors  MoyskladSyncCursor[]
  syncLogs     MoyskladSyncLog[]

  @@unique([organizationId, accountId])
  @@map("moysklad_connections")
}

model MoyskladSyncCursor {
  entity       String    @map("entity")
  connectionId String    @map("connection_id")
  lastUpdated  DateTime? @map("last_updated")

  connection MoyskladConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@id([entity, connectionId])
  @@map("moysklad_sync_cursor")
}

model MoyskladSyncLog {
  id           BigInt    @id @default(autoincrement())
  direction    SyncDir
  entity       String?
  connectionId String?   @map("connection_id")
  ok           Boolean
  count        Int       @default(0)
  error        String?
  startedAt    DateTime  @map("started_at")
  finishedAt   DateTime? @map("finished_at")

  connection MoyskladConnection? @relation(fields: [connectionId], references: [id])

  @@index([connectionId, startedAt])
  @@map("moysklad_sync_log")
}

// ─── SYNC INFRASTRUCTURE ─────────────────────────────────────────────────────

model SyncCursor {
  entity      String    @map("entity")
  connectionId String   @map("connection_id")
  lastTs      DateTime? @map("last_ts")
  lastGuid    String?   @map("last_guid")

  connection OnecConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@id([entity, connectionId])
  @@map("sync_cursor")
}

model IdMap {
  entity       String @map("entity")
  localId      String @map("local_id")
  connectionId String @map("connection_id")
  onecGuid     String @map("onec_guid")
  syncedAt     DateTime @default(now()) @map("synced_at")

  connection OnecConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@id([connectionId, entity, localId])
  @@unique([entity, connectionId, onecGuid])
  @@index([entity, connectionId])
  @@map("id_map")
}

model Outbox {
  id              String      @id @default(uuid())
  idempotencyKey  String      @unique @map("idempotency_key")
  entity          String
  localId         String      @map("local_id")
  // FP-009: клиент записи — из контекста транзакции (SET LOCAL flowpos.tenant_id), в которой записан агрегат.
  tenantId        String      @default(dbgenerated("NULLIF(current_setting('flowpos.tenant_id', true), '')")) @map("tenant_id")
  connectionId    String?     @map("connection_id")
  operation       String
  payload         Json
  status          OutboxStatus @default(PENDING)
  attempts        Int         @default(0)
  nextAttemptAt   DateTime    @default(now()) @map("next_attempt_at")
  lastError       String?     @map("last_error")
  // FP-021: аренда записи воркером. Подтвердить результат может только владелец текущей аренды
  // (lease_owner + fencing_version); stage — дошла ли попытка до сети (CLAIMED — нет, SENDING — запрос отправлялся).
  leaseOwner      String?     @map("lease_owner")
  leaseUntil      DateTime?   @map("lease_until")
  fencingVersion  Int         @default(0) @map("fencing_version")
  stage           String?
  processedAt     DateTime?   @map("processed_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  connection OnecConnection? @relation(fields: [connectionId], references: [id])

  @@index([status, nextAttemptAt])
  @@index([entity, localId])
  @@index([tenantId, status])
  @@map("outbox")
}

enum OutboxStatus {
  PENDING
  SENDING
  DONE
  ERROR
  DEAD
  UNKNOWN // FP-021: запрос мог дойти до 1С, а ответ потерян — автоматически не повторяется, решает оператор
}

model SyncLog {
  id           BigInt    @id @default(autoincrement())
  direction    SyncDir
  entity       String?
  connectionId String?   @map("connection_id")
  ok           Boolean
  count        Int       @default(0)
  error        String?
  startedAt    DateTime  @map("started_at")
  finishedAt   DateTime? @map("finished_at")

  connection OnecConnection? @relation(fields: [connectionId], references: [id])

  @@index([connectionId, startedAt])
  @@map("sync_log")
}

enum SyncDir {
  PULL
  PUSH
}

// ─── CATALOG (mirror from 1С) ─────────────────────────────────────────────────

// Sync mixin fields are embedded directly on each model

model ProductGroup {
  id         String   @id @default(uuid())
  tenantId       String  @default(dbgenerated("NULLIF(current_setting('flowpos.tenant_id', true), '')")) @map("tenant_id")
  name       String
  code       String?
  parentId   String?  @map("parent_id")
  // sync fields — 1С
  onecGuid   String?  @map("onec_guid")
  onecBase   String   @default("default") @map("onec_base")
  onecVersion String? @map("onec_version")
  // sync fields — МойСклад
  msId           String?  @map("ms_id")
  msAccountId    String?  @map("ms_account_id")
  msConnectionId String?  @map("ms_connection_id")
  msUpdated      DateTime? @map("ms_updated")
  syncStatus SyncStatus @default(SYNCED) @map("sync_status")
  owner      Owner      @default(C1) @map("owner")
  deleted    Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  parent   ProductGroup?  @relation("GroupTree", fields: [tenantId, parentId], references: [tenantId, id])
  children ProductGroup[] @relation("GroupTree")
  products Product[]

  @@unique([tenantId, onecBase, onecGuid])
  @@unique([tenantId, msAccountId, msId])
  @@index([syncStatus])
  @@unique([tenantId, id])
  @@map("product_groups")
}

model Uom {
  id         String  @id @default(uuid())
  tenantId       String  @default(dbgenerated("NULLIF(current_setting('flowpos.tenant_id', true), '')")) @map("tenant_id")
  name       String
  shortName  String  @map("short_name")
  code       String?
  isBase     Boolean @default(false) @map("is_base")
  // sync fields — 1С
  onecGuid   String? @map("onec_guid")
  onecBase   String  @default("default") @map("onec_base")
  // sync fields — МойСклад
  msId           String?  @map("ms_id")
  msAccountId    String?  @map("ms_account_id")
  msConnectionId String?  @map("ms_connection_id")
  msUpdated      DateTime? @map("ms_updated")
  syncStatus SyncStatus @default(SYNCED) @map("sync_status")
  deleted    Boolean @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  products Product[]
  barcodes ProductBarcode[]

  @@unique([tenantId, id])
  @@map("uoms")
}

model Product {
  id         String      @id @default(uuid())
  kind       ProductKind @default(PRODUCT)
  code       String?
  article    String?
  name       String
  groupId    String?     @map("group_id")
  uomId      String      @map("uom_id")
  vatRate    Decimal?    @map("vat_rate") @db.Decimal(5,2)
  barcode    String?
  parentId   String?     @map("parent_id")
  attributes Json?
  /// FP-025: характеристики варианта в каноническом виде («Размер=M|Цвет=Красный»); одна комбинация на родителя
  variantKey String?     @map("variant_key")
  /// FP-025: код весового товара (PLU) для весовых штрихкодов; уникален у клиента
  plu        String?
  // sync fields — 1С
  onecGuid   String?     @map("onec_guid") @db.Uuid
  onecBase   String      @default("default") @map("onec_base")
  onecVersion String?    @map("onec_version")
  // sync fields — МойСклад
  msId           String?  @map("ms_id")
  msAccountId    String?  @map("ms_account_id")
  msConnectionId String?  @map("ms_connection_id")
  msUpdated      DateTime? @map("ms_updated")
  syncStatus SyncStatus  @default(SYNCED) @map("sync_status")
  owner      Owner       @default(C1) @map("owner")
  deleted    Boolean     @default(false)
  organizationId String?  @map("organization_id") // null — общий справочник тенанта
  tenantId       String  @default(dbgenerated("NULLIF(current_setting('flowpos.tenant_id', true), '')")) @map("tenant_id")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  updatedBy  String?     @map("updated_by")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  organization Organization? @relation(fields: [tenantId, organizationId], references: [tenantId, id])
  group      ProductGroup? @relation(fields: [tenantId, groupId], references: [tenantId, id])
  uom        Uom           @relation(fields: [tenantId, uomId], references: [tenantId, id])
  parent     Product?      @relation("ProductVariants", fields: [tenantId, parentId], references: [tenantId, id])
  variants   Product[]     @relation("ProductVariants")
  barcodes   ProductBarcode[]
  prices     Price[]
  docLines   DocumentLine[]
  stocks     Stock[]

  @@unique([tenantId, onecBase, onecGuid])
  @@unique([tenantId, msAccountId, msId])
  @@unique([tenantId, plu])
  @@unique([tenantId, parentId, variantKey])
  @@index([name])
  @@index([syncStatus])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("products")
}

enum ProductKind {
  PRODUCT
  SERVICE
  BUNDLE
  VARIANT
}

/// Штрихкод товара. FP-025: уникален в пределах клиента (раньше — во всей БД: одинаковый EAN у двух клиентов
/// не заводился). Штрихкод упаковки — с коэффициентом к базовой единице товара (коробка = 12 шт).
model ProductBarcode {
  id        String   @id @default(uuid())
  tenantId       String  @default(dbgenerated("NULLIF(current_setting('flowpos.tenant_id', true), '')")) @map("tenant_id")
  productId String   @map("product_id")
  barcode   String
  kind      String   @default("EAN13") // EAN13 | EAN8 | UPCA | GTIN14 | CODE128
  /// Сколько базовых единиц товара в одной отсканированной (1 — штучный; 12 — коробка)
  factor    Decimal  @default(1) @db.Decimal(18, 6)
  uomId     String?  @map("uom_id")    // единица упаковки (для отображения)
  source    String   @default("MANUAL") // MANUAL | MOYSKLAD | ONEC | LEGACY
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)
  uom     Uom?    @relation(fields: [tenantId, uomId], references: [tenantId, id])

  @@unique([tenantId, barcode])
  @@index([productId])
  @@map("product_barcodes")
}

/// FP-025: настройки каталога клиента — весовые штрихкоды (EAN-13: префикс + PLU + вес в граммах + контрольная).
model CatalogSettings {
  tenantId          String   @id @default(dbgenerated("NULLIF(current_setting('flowpos.tenant_id', true), '')")) @map("tenant_id")
  weightPrefixes    String[] @default([]) @map("weight_prefixes")
  weightPluLength   Int      @default(5) @map("weight_plu_length")
  updatedAt         DateTime @updatedAt @map("updated_at")
  updatedBy         String?  @map("updated_by")

  @@map("catalog_settings")
}

/// FP-025: версии товара — неизменяемый снимок значимых полей при каждом изменении (заполняет триггер БД, в т.ч.
/// при записи из обмена с 1С/МойСклад). Документы и ЭСФ видят, каким товар был на дату.
model ProductVersion {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  productId String   @map("product_id")
  version   Int
  snapshot  Json
  changed   String[]
  changedBy String?  @map("changed_by")
  traceId   String?  @default(dbgenerated("NULLIF(current_setting('flowpos.trace_id'::text, true), ''::text)")) @map("trace_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([productId, version])
  @@index([tenantId, productId])
  @@map("product_versions")
}

/// FP-025: сопоставление объекта FlowPOS с идентификатором во внешней системе. Внутренний id стабилен; внешний может
/// смениться (пересоздание в МойСклад) — прежняя связь остаётся в истории как DETACHED.
model ExternalMapping {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  entityType  String    @map("entity_type") // product
  entityId    String    @map("entity_id")
  system      String    // MOYSKLAD | ONEC
  account     String    // аккаунт МойСклад / база 1С
  externalId  String    @map("external_id")
  status      String    @default("ACTIVE") // ACTIVE | DETACHED
  firstSeenAt DateTime  @default(now()) @map("first_seen_at")
  detachedAt  DateTime? @map("detached_at")

  @@unique([tenantId, entityType, system, account, externalId])
  @@index([tenantId, entityType, entityId])
  @@map("external_mappings")
}

model PriceType {
  id         String  @id @default(uuid())
  tenantId       String  @default(dbgenerated("NULLIF(current_setting('flowpos.tenant_id', true), '')")) @map("tenant_id")
  name       String
  currency   String  @default("KZT")
  isDefault  Boolean @default(false) @map("is_default")
  isActive   Boolean @default(true) @map("is_active")
  onecGuid   String? @map("onec_guid")
  onecBase   String  @default("default") @map("onec_base")
  syncStatus SyncStatus @default(SYNCED) @map("sync_status")
  deleted    Boolean @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  prices Price[]

  @@unique([tenantId, id])
  @@map("price_types")
}

model Price {
  id          String   @id @default(uuid())
  tenantId       String  @default(dbgenerated("NULLIF(current_setting('flowpos.tenant_id', true), '')")) @map("tenant_id")
  productId   String   @map("product_id")
