{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strict": false,
    "paths": {
      "@flowpos/moysklad-client": ["../../packages/moysklad-client/src"],
      "@flowpos/shared-types": ["../../packages/shared-types/src"]
    }
  },
  "include": ["src/**/*"]
}
