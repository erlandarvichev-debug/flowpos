              "OUT"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "DRAFT",
              "APPROVED",
              "SENDING",
              "UNKNOWN",
              "REGISTERED",
              "REJECTED",
              "RECEIVED",
              "QUARANTINED"
