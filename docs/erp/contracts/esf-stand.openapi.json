    "schemas": {
      "Invoice": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "number",
          "amountMinor",
          "currency"
        ],
        "properties": {
          "number": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "amountMinor": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,14}$"
          },
          "currency": {
            "type": "string",
            "enum": [
              "KZT"
            ]
          }
        }
      },
      "Document": {
        "type": "object",
        "required": [
