{
  "openapi": "3.1.0",
  "info": {
    "title": "FlowPOS ESF LOCAL SYNTHETIC stand",
    "version": "0.2.0",
    "description": "Internal synthetic ESF API. AuthProvider supplies fixed local fixture principal; header selects organization only within server grants and never supplies identity/tenant. No credentials, live ESF or production authentication."
