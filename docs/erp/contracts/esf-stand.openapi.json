    "/api/session": {
      "get": {
        "summary": "Получить локальный token; только same-origin",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string"
                    },
                    "mode": {
                      "const": "SYNTHETIC"
                    },
                    "gate": {
                      "const": "CONTRACT_UNVERIFIED"
                    },
                    "identitySource": {
                      "const": "LOCAL_FIXTURE"
                    },
                    "subject": {
                      "type": "string"
                    },
                    "organizations": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "actions": {
                            "type": "array",
                            "items": {
                              "enum": [
                                "read",
                                "draft",
                                "approve",
                                "send",
                                "reconcile",
                                "ingest"
                              ]
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code"
                  ],
                  "properties": {
                    "code": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Host/origin/token denied",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code"
                  ],
                  "properties": {
                    "code": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not found",
