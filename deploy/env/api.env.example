# FlowPOS API — боевые настройки. Копия лежит на сервере: /opt/flowpos/shared/api.env (права 600, владелец flowpos).
# Секреты генерирует scripts/install.sh. В репозиторий настоящие значения НЕ коммитить.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000

# PostgreSQL 16 (локально на сервере)
# FP-009: API и воркеры работают под рабочей ролью flowpos_app (без BYPASSRLS — действует RLS).
DATABASE_URL=postgresql://flowpos_app:<пароль-рабочей-роли>@127.0.0.1:5432/flowpos?schema=public
# Владелец таблиц: миграции при выкладке и бэкапы (BYPASSRLS). Приложение этим адресом не пользуется.
MIGRATION_DATABASE_URL=postgresql://flowpos:<пароль-БД>@127.0.0.1:5432/flowpos?schema=public
REDIS_URL=redis://127.0.0.1:6379

# ≥ 32 символов, случайный: openssl rand -hex 32. Без него API не запустится.
JWT_SECRET=<сгенерировать>
JWT_EXPIRES_IN=15m

# Привязка подписи ЭСФ к точным байтам (HMAC запросов на подпись). ≥ 32 символов. Без него API не запустится.
ESF_SIGNING_SECRET=<сгенерировать>
# Ключ шифрования секретов второго фактора (TOTP). Сменить = все подключённые MFA перестанут работать.
MFA_SECRET_KEY=<сгенерировать>

# Вход через внешнего провайдера (OIDC: Keycloak, Azure AD, Google Workspace…). Не задано — выключен.
# Учётная запись провайдера привязывается пользователем в профиле; по email автоматически не связывается.
# OIDC_ISSUER=https://idp.example.kz/realms/flowpos
# OIDC_CLIENT_ID=flowpos
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://app.example.kz/api/v1/auth/oidc/callback
# OIDC_WEB_REDIRECT=https://app.example.kz/login

# Адрес веб-интерфейса (CORS и cookie)
CORS_ORIGIN=https://app.example.kz

# Swagger в бою выключен; включить временно: SWAGGER_ENABLED=1
SWAGGER_ENABLED=0

# Фоновые задачи бухгалтерии: автопилот (15 с) и ИС ЭСФ (60 с)
ACC_AUTOPILOT_INTERVAL_MS=15000
ESF_INTERVAL_MS=60000

# Интеграции (заполнить, если используются)
MOYSKLAD_TOKEN=
ONEC_BASE_URL=
ONEC_USERNAME=
ONEC_PASSWORD=
ONEC_INFOBASE=
