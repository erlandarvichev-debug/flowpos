# FlowPOS MCP для клиентов (Claude). На сервере: /opt/flowpos/shared/mcp.env (права 600).
MCP_PUBLIC_URL=https://mcp.example.kz
MCP_HOST=127.0.0.1
MCP_PORT=3100
# ≥ 32 символов, случайный: openssl rand -hex 32. Шифрует сессии клиентов — НЕ менять после запуска
# (иначе все клиенты должны будут переподключиться).
MCP_STATE_KEY=<сгенерировать>
MCP_STATE_FILE=/opt/flowpos/shared/data/mcp-oauth.json
FLOWPOS_API_URL=http://127.0.0.1:3000
FLOWPOS_WEB_URL=https://app.example.kz
