{
  "name": "flowpos",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "jest --config jest.config.js --runInBand",
    "test:watch": "jest --config jest.config.js --watch",
    "test:esf": "node --test erp/esf-stand/*.node-test.ts",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:sync": "npm run dev --workspace=apps/sync-worker",
    "dev:push": "npm run dev --workspace=apps/push-worker",
    "dev:analytics": "npm run dev --workspace=apps/analytics-worker",
    "dev:moysklad": "npm run dev --workspace=apps/moysklad-worker",
    "dev:workers": "concurrently \"npm run dev:sync\" \"npm run dev:push\" \"npm run dev:analytics\" \"npm run dev:moysklad\"",
    "dev:esf": "node erp/esf-stand/server.ts",
    "build": "npm run build --workspaces",
    "typecheck:esf": "tsc -p erp/esf-stand/tsconfig.json",
    "db:generate": "npm run db:generate --workspace=apps/api",
    "db:migrate": "npm run db:migrate --workspace=apps/api",
    "db:seed": "npm run db:seed --workspace=apps/api",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "test:acc": "npm run test:int --workspace=apps/api",
    "db:push": "npm run push --workspace=packages/db"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.28",
    "@types/jest": "^30.0.0",
    "axios-mock-adapter": "^2.1.0",
    "concurrently": "^8.2.2",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11"
  },
  "allowScripts": {
    "@nestjs/core@10.4.22": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "fsevents@2.3.3": true,
    "prisma@5.22.0": true
  }
}
